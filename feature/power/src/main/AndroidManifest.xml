<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.charging.ChargeQuickTileService"
            android:exported="true"
            android:icon="@drawable/rounded_battery_android_frame_shield_24"
            android:label="@string/tile_charge_optimization"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.battery.BatteryNotificationTileService"
            android:exported="true"
            android:icon="@drawable/rounded_battery_charging_60_24"
            android:label="@string/feat_battery_notification_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.battery.BatteryNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.property.FOREGROUND_SERVICE_TYPE_SPECIAL_USE_DESCRIPTION"
                android:value="Battery Notification Service" />
        </service>

        <receiver
            android:name="com.jawzf.pixeltoolkit.feature.power.widget.BatteriesWidgetReceiver"
            android:exported="true"
            android:label="@string/batteries_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.BATTERY_CHANGED" />
                <action android:name="android.bluetooth.device.action.BATTERY_LEVEL_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/batteries_widget_info" />
        </receiver>

        <activity
            android:name="com.jawzf.pixeltoolkit.feature.power.battery.BatteryDetailsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Toolkit.Translucent" />

        <activity
            android:name="com.jawzf.pixeltoolkit.feature.power.widget.BatteriesWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Toolkit.Translucent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.caffeinate.CaffeinateTileService"
            android:exported="true"
            android:icon="@drawable/rounded_coffee_24"
            android:label="Caffeinate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.caffeinate.CaffeinateWakeLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.property.FOREGROUND_SERVICE_TYPE_SPECIAL_USE_DESCRIPTION"
                android:value="Caffeinate Service" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.power.maps.MapsPowerSavingTileService"
            android:exported="true"
            android:icon="@drawable/rounded_navigation_24"
            android:label="@string/tile_maps_power_saving"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>
    </application>

</manifest>
