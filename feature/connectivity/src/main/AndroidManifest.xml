<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="com.jawzf.pixeltoolkit.feature.connectivity.nfc.NfcTileService"
            android:exported="true"
            android:icon="@drawable/rounded_nfc_24"
            android:label="@string/nfc_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.connectivity.sim.DataSimTileService"
            android:exported="true"
            android:icon="@drawable/rounded_sim_card_24"
            android:label="@string/tile_data_sim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.connectivity.dns.PrivateDnsTileService"
            android:exported="true"
            android:icon="@drawable/rounded_dns_24"
            android:label="@string/tile_private_dns"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>
    </application>

    <instrumentation
        android:name="com.jawzf.pixeltoolkit.feature.connectivity.sim.CarrierConfigModifier"
        android:label="CarrierConfigModifier"
        android:targetPackage="${applicationId}" />

</manifest>
