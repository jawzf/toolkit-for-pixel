<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="com.jawzf.pixeltoolkit.feature.sound.mode.SoundModeTileService"
            android:exported="true"
            android:icon="@drawable/rounded_volume_up_24"
            android:label="Sound Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_UTILITIES" />
        </service>

        <service
            android:name="com.jawzf.pixeltoolkit.feature.sound.mono.MonoAudioTileService"
            android:exported="true"
            android:icon="@drawable/rounded_headphones_24"
            android:label="Mono Audio"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_ACCESSIBILITY" />
        </service>

        <receiver
            android:name="com.jawzf.pixeltoolkit.feature.sound.callvibration.CallVibrationReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
