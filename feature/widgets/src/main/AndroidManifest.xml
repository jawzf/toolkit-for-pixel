<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.jawzf.pixeltoolkit.feature.widgets.stack.StackWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stack_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stack_info" />
        </receiver>

        <receiver
            android:name="com.jawzf.pixeltoolkit.feature.widgets.screenoff.ScreenOffWidgetProvider"
            android:exported="false"
            android:label="@string/screen_off_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/screen_off_widget_info" />
        </receiver>

        <activity
            android:name="com.jawzf.pixeltoolkit.feature.widgets.screenoff.ScreenOffWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Toolkit.Translucent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
